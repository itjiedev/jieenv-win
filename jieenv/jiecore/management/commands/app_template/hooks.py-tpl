"""
{{ app_name }} 生命周期钩子

jiecore 在应用安装、启用、禁用、卸载、删除时自动调用对应钩子函数。
所有钩子均为可选，未定义的钩子会自动跳过。

参数 context 包含：
    - app_name: 应用名称
    - app_dir:  应用目录路径 (Path)
    - action:   操作名称
    - version:  应用版本号（如可获取）

异常处理：
    - 普通异常：记录日志，不阻塞主流程
    - HookAbortError：主动中止操作（阻塞主流程）
      from jiecore.app_hooks import HookAbortError
      raise HookAbortError('中止原因')
"""
import logging

logger = logging.getLogger(__name__)


def on_install(context):
    """安装完成后调用（文件已复制、迁移已执行）"""
    logger.info('应用 %s 安装完成', context['app_name'])
    # 可用来初始化默认配置、创建初始数据等
    pass


def on_enable(context):
    """启用完成后调用（状态已更新、迁移已执行、热加载已完成）"""
    logger.info('应用 %s 已启用', context['app_name'])
    # 可用来初始化运行时状态、注册外部资源等
    pass


def on_disable(context):
    """禁用完成后调用（状态已更新、路由已清理、服务已清除）"""
    logger.info('应用 %s 已禁用', context['app_name'])
    # 可用来释放资源、清理外部引用等
    pass


def on_uninstall(context):
    """卸载完成后调用（迁移已回滚、数据库已清理，文件保留）"""
    logger.info('应用 %s 已卸载', context['app_name'])
    # 可用来备份自定义数据、清理外部依赖等
    pass


def on_delete(context):
    """删除文件之前调用（钩子仍可读取应用文件）"""
    logger.info('应用 %s 即将删除', context['app_name'])
    # 可用来执行最终清理（如删除应用目录外的关联文件）
    pass
