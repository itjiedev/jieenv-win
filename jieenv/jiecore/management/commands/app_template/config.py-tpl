"""
{{ app_name }} 应用配置

定义应用常量、数据目录、临时目录等。
"""
import logging

from django.conf import settings

logger = logging.getLogger(__name__)

APP_LABEL = '{{ app_name }}'
DATA_DIR = settings.DATA_DIR / APP_LABEL
TMP_DIR = settings.TMP_DIR / APP_LABEL

for _d in [DATA_DIR, TMP_DIR]:
    _d.mkdir(parents=True, exist_ok=True)