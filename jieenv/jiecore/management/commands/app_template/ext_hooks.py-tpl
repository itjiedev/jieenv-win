"""
{{ app_name }} 扩展钩子

本文件用于向其他应用（宿主应用）声明的扩展点注册处理器。
宿主应用通过 call_hooks() 收集并渲染到页面内部特定区域。

本文件在应用启用时自动加载，应用禁用/卸载时自动清理。

─────────────────────────────────────────────────────────────────────────────
扩展点命名约定
─────────────────────────────────────────────────────────────────────────────
格式：{宿主应用名}.{页面/功能}.{位置}
示例：
    - dbmysql.instance_detail.actions    # MySQL 实例详情页操作区
    - mainapp.header.tools               # 主应用顶部工具栏

─────────────────────────────────────────────────────────────────────────────
注册处理器示例
─────────────────────────────────────────────────────────────────────────────
from jiecore.ext_hook_registry import register_hook

# 示例 1：注册简单函数处理器
def my_handler(context):
    '''
    处理器函数
    :param context: dict，包含宿主传递的上下文数据
    :return: dict 或 None，返回的数据会被宿主收集并渲染
    '''
    if context.get('instance_type') == 'mysql':
        return {
            'label': 'SQL 分析',
            'icon': 'chart-bar',
            'url': f'/{{ app_name }}/analyze/{context["instance_id"]}/',
        }
    return None

register_hook('dbmysql.instance_detail.actions', my_handler, sort=10)


# 示例 2：注册可调用类处理器
class MyHandler:
    '''可调用类处理器，适合需要初始化状态的复杂逻辑'''
    def __init__(self):
        self.config = {}

    def __call__(self, context):
        return {'label': '功能入口', 'url': '/{{ app_name }}/feature/'}

register_hook('dbmysql.instance_detail.actions', MyHandler(), sort=20)

─────────────────────────────────────────────────────────────────────────────
注意事项
─────────────────────────────────────────────────────────────────────────────
1. 扩展点由宿主应用声明，本应用只是注册处理器
2. 处理器返回 None 时宿主不会渲染该处理器
3. sort 参数控制同一扩展点上多个处理器的显示顺序（数值越小越靠前）
4. 应用禁用/卸载时会自动清理本文件注册的所有钩子
5. 如果本应用不需要扩展其他应用的页面，可以删除此文件或保持为空
"""
import logging

logger = logging.getLogger(__name__)


def register():
    """扩展钩子注册入口。框架自动扫描并调用此函数。
    当前阶段暂不需要扩展其他应用时，保留空函数占位即可。"""
    pass