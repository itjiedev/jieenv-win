"""
{{ app_name }} 视图层

页面视图和 JSON API 定义在此文件中。
所有业务视图都应继承 jiecore.views.AppMixin 以支持菜单高亮。
"""
import logging

from django.views.generic.base import TemplateView
from django.views.decorators.http import require_GET, require_POST
from django.http import JsonResponse

from jiecore.views import AppMixin

logger = logging.getLogger(__name__)


# ── 菜单高亮 Mixin（所有本应用视图继承此 Mixin）────────

class {{ camel_case_app_name }}Mixin(AppMixin):
    """菜单高亮 Mixin，设置当前应用的菜单ID"""
    parent_menu_id = '{{ app_name }}'
    menu_id = '{{ app_name }}'


# ── 页面视图 ─────────────────────────────────────────

class IndexView({{ camel_case_app_name }}Mixin, TemplateView):
    """首页"""
    template_name = '{{ app_name }}/index.html'

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        context['page_title'] = '{{ app_name }}'
        return context


